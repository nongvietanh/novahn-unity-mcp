<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="novahn-studio" class="novahn-studio">
        <ui:VisualElement class="studio-sidebar">
            <ui:VisualElement class="studio-brand">
                <ui:Label text="N/" class="studio-monogram" />
                <ui:VisualElement>
                    <ui:Label text="NOVAHN" class="studio-wordmark" />
                    <ui:Label text="UNITY STUDIO" class="studio-brand-caption" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="WORKSPACE" class="studio-nav-heading" />
            <ui:VisualElement name="workspace-nav" />
            <ui:Label text="UNITY ENGINE" class="studio-nav-heading" />
            <ui:VisualElement name="engine-nav" />
            <ui:VisualElement class="studio-sidebar-bottom">
                <ui:Label name="preview-label" text="NOVAHN STUDIO" class="studio-preview-label" />
                <ui:Label name="preview-caption" text="A workspace for your AI team." class="studio-muted studio-wrap" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="studio-workspace">
            <ui:VisualElement class="studio-topbar">
                <ui:Label name="project-name" class="studio-project-name" />
                <ui:Label text="/  AI WORKSPACE" class="studio-crumb" />
                <ui:VisualElement class="studio-spacer" />
                <ui:Label name="connection-badge" class="studio-connection-badge" />
                <ui:DropdownField name="studio-language" tooltip="Language / Ngôn ngữ" />
                <ui:Button name="console-button" text="AI Log ↗" class="studio-button" />
            </ui:VisualElement>
            <ui:VisualElement class="studio-page-header">
                <ui:Label name="page-title" class="studio-page-title" />
                <ui:Label name="page-subtitle" class="studio-page-subtitle studio-wrap" />
            </ui:VisualElement>
            <ui:VisualElement name="studio-content" class="studio-content" />
            <ui:VisualElement class="studio-footer">
                <ui:Label name="version-label" />
                <ui:VisualElement class="studio-spacer" />
                <ui:Label text="NOVAHN  /  BUILD TOGETHER" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
