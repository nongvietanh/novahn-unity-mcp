/* Native Editor look: inherit the Editor theme's background, text and field colors (light and dark),
   and layer translucent greys on top, like Advanced/Editor Preferences. One accent color only. */
.novahn-studio { flex-grow: 1; flex-direction: row; font-size: 12px; }
.studio-sidebar { width: 170px; min-width: 170px; background-color: rgba(0, 0, 0, 0.12); border-right-width: 1px; border-right-color: rgba(0, 0, 0, 0.3); padding: 12px 8px; }
.studio-brand { flex-direction: row; align-items: center; margin-bottom: 16px; padding-left: 4px; }
.studio-monogram { background-color: #4a90e2; color: #ffffff; font-size: 11px; -unity-font-style: bold; width: 26px; height: 26px; border-radius: 4px; -unity-text-align: middle-center; margin-right: 8px; }
.studio-wordmark { font-size: 13px; -unity-font-style: bold; }
.studio-brand-caption { font-size: 10px; color: #8f8f8f; }
.studio-nav-heading { color: #8f8f8f; font-size: 10px; -unity-font-style: bold; margin: 12px 0 4px 6px; }
.studio-nav-button { flex-direction: row; align-items: center; height: 26px; margin: 1px 0; border-width: 0; border-radius: 3px; background-color: rgba(0, 0, 0, 0); padding: 0 6px; -unity-text-align: middle-left; }
.studio-nav-button:hover { background-color: rgba(128, 128, 128, 0.18); }
.studio-nav-button.selected { background-color: rgba(74, 144, 226, 0.35); -unity-font-style: bold; }
.studio-sidebar-bottom { margin-top: auto; border-top-width: 1px; border-top-color: rgba(0, 0, 0, 0.25); padding-top: 10px; }
.studio-preview-label { color: #8f8f8f; font-size: 10px; -unity-font-style: bold; margin-bottom: 2px; }
.studio-workspace { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.studio-topbar { flex-direction: row; align-items: center; min-height: 34px; padding: 0 16px; border-bottom-width: 1px; border-bottom-color: rgba(0, 0, 0, 0.3); background-color: rgba(0, 0, 0, 0.06); }
.studio-project-name { -unity-font-style: bold; }
.studio-crumb { color: #8f8f8f; font-size: 11px; margin-left: 6px; }
.studio-spacer { flex-grow: 1; }
.studio-connection-badge { color: #8f8f8f; font-size: 11px; margin-right: 10px; }
.studio-connection-badge.online { color: #6fbf73; }
.studio-page-header { padding: 14px 16px 12px 16px; border-bottom-width: 1px; border-bottom-color: rgba(0, 0, 0, 0.2); margin-bottom: 12px; }
.studio-page-title { font-size: 18px; -unity-font-style: bold; margin-bottom: 4px; }
.studio-page-subtitle { color: #8f8f8f; }
.studio-content { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.studio-scroll { flex-grow: 1; }
.studio-page { padding: 0 16px 16px 16px; }
.studio-footer { flex-direction: row; padding: 4px 16px; border-top-width: 1px; border-top-color: rgba(0, 0, 0, 0.3); color: #8f8f8f; font-size: 10px; }
.studio-wrap { white-space: normal; }
.studio-muted { color: #8f8f8f; white-space: normal; }
.studio-section-heading { font-size: 13px; -unity-font-style: bold; margin: 14px 0 8px 0; }
.studio-row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.studio-row > .studio-button { margin-right: 4px; margin-bottom: 4px; }
.studio-card { background-color: rgba(0, 0, 0, 0.06); border-width: 1px; border-color: rgba(0, 0, 0, 0.2); border-radius: 4px; padding: 10px 12px; margin-bottom: 10px; min-width: 0; }
.studio-hero { background-color: rgba(0, 0, 0, 0.06); border-width: 1px; border-color: rgba(0, 0, 0, 0.2); border-radius: 4px; padding: 12px; margin-bottom: 12px; }
.studio-hero-title { font-size: 15px; -unity-font-style: bold; white-space: normal; margin-bottom: 4px; }
.studio-hero-copy { color: #8f8f8f; white-space: normal; margin-bottom: 10px; }
.studio-stat-row { flex-direction: row; flex-wrap: wrap; margin-bottom: 6px; }
.studio-stat { flex-grow: 1; flex-basis: 22%; min-width: 110px; margin-right: 6px; margin-bottom: 6px; padding: 8px 10px; background-color: rgba(0, 0, 0, 0.06); border-width: 1px; border-color: rgba(0, 0, 0, 0.2); border-radius: 4px; }
.studio-stat-value { font-size: 18px; -unity-font-style: bold; }
.studio-stat-label { color: #8f8f8f; font-size: 10px; margin-top: 2px; }
.studio-step { flex-direction: row; align-items: center; padding: 8px 4px; border-bottom-width: 1px; border-bottom-color: rgba(0, 0, 0, 0.18); }
.studio-step-number { color: #8f8f8f; width: 28px; }
.studio-step-copy { flex-grow: 1; flex-shrink: 1; }
.studio-card > .studio-button { align-self: flex-start; }
.studio-card-title { font-size: 13px; -unity-font-style: bold; margin-bottom: 4px; white-space: normal; }
.studio-button { min-height: 22px; padding: 2px 10px; margin: 0; }
.studio-button.primary { background-color: #4a90e2; border-color: #3a7bc8; color: #ffffff; }
.studio-button.primary:hover { background-color: #357abd; }
.studio-button.danger { color: #e06c6c; }
.studio-button:disabled { opacity: 0.5; }
.studio-note { white-space: normal; color: #8f8f8f; background-color: rgba(74, 144, 226, 0.08); border-left-width: 2px; border-left-color: #4a90e2; padding: 8px 10px; margin-bottom: 10px; }
.studio-feedback { white-space: normal; color: #d9a54a; margin: 2px 0; }
.studio-chip { font-size: 10px; padding: 1px 6px; border-radius: 3px; background-color: rgba(111, 191, 115, 0.22); margin-right: 6px; -unity-text-align: middle-center; }
.studio-chip.worker { background-color: rgba(74, 144, 226, 0.22); }
.studio-agent-header { flex-direction: row; align-items: center; margin-bottom: 8px; }
.studio-agent-avatar { width: 28px; height: 28px; background-color: rgba(128, 128, 128, 0.25); border-radius: 4px; font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; margin-right: 8px; }
.studio-agent-meta { flex-grow: 1; flex-shrink: 1; }
.studio-agent-status { color: #8f8f8f; font-size: 11px; margin-top: 1px; }
.studio-agent-form { flex-direction: row; flex-wrap: wrap; align-items: center; }
.studio-agent-form > .unity-base-field { flex-grow: 1; flex-basis: 220px; margin: 0 8px 4px 0; }
.studio-agent-form > .studio-port-field { flex-grow: 0; flex-basis: 130px; }
.studio-agent-form > .studio-wide-field { flex-basis: 320px; flex-grow: 2; }
.studio-agent-form .unity-base-field__label { min-width: 60px; width: auto; }
.studio-agent-actions { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.studio-agent-actions > .studio-button { margin-right: 4px; margin-top: 4px; }
.studio-empty { padding: 12px; border-width: 1px; border-color: rgba(128, 128, 128, 0.3); border-radius: 4px; margin-bottom: 10px; color: #8f8f8f; white-space: normal; -unity-text-align: middle-center; }
.studio-board { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.studio-column { flex-grow: 1; flex-basis: 30%; min-width: 200px; margin-right: 8px; }
.studio-column-title { color: #8f8f8f; font-size: 11px; -unity-font-style: bold; margin: 4px 0 8px 0; padding-bottom: 4px; border-bottom-width: 1px; border-bottom-color: rgba(0, 0, 0, 0.2); }
.studio-task-body { white-space: normal; color: #8f8f8f; margin: 4px 0 6px 0; }
.studio-form-field { margin-bottom: 4px; }
.studio-form-field > .unity-base-field__label { min-width: 120px; }
.studio-brief .unity-text-field__input { min-height: 80px; white-space: normal; }
.studio-skill-path { color: #8f8f8f; white-space: normal; font-size: 11px; margin: 4px 0; }
.studio-library-item { padding: 6px 0; border-bottom-width: 1px; border-bottom-color: rgba(0, 0, 0, 0.18); }
#studio-language {
    width: 64px;
    min-width: 64px;
    margin-left: 8px;
    margin-right: 8px;
}
.studio-toolbar { flex-direction: row; align-items: center; flex-wrap: wrap; }
.studio-toolbar > .studio-button { margin: 0 0 0 4px; }
.studio-toolbar-label { flex-grow: 1; flex-shrink: 1; margin-right: 8px; white-space: normal; }
.studio-grow { flex-grow: 1; flex-shrink: 1; min-width: 160px; margin: 0; }
.studio-update-status { color: #8f8f8f; font-size: 11px; margin-right: 8px; flex-shrink: 1; overflow: hidden; }
#update-button { margin-left: 8px; margin-right: 4px; }

/* Shared MCP sections (Connection, Tools...) inherit Common.uss accents; keep them native here. */
.novahn-studio .action-button,
.novahn-studio .secondary-button,
.novahn-studio .primary-button {
    background-color: var(--unity-colors-button-background);
    border-color: var(--unity-colors-button-border);
    color: var(--unity-colors-button-text);
    border-width: 1px;
    border-radius: 3px;
    height: 22px;
    min-height: 22px;
    font-size: 12px;
    letter-spacing: 0;
    -unity-font-style: normal;
}
.novahn-studio .action-button:hover,
.novahn-studio .secondary-button:hover,
.novahn-studio .primary-button:hover { background-color: var(--unity-colors-button-background-hover); border-color: var(--unity-colors-button-border); }
.novahn-studio .action-button:active,
.novahn-studio .secondary-button:active,
.novahn-studio .primary-button:active { background-color: var(--unity-colors-button-background-pressed); }
.novahn-studio .primary-button { background-color: #4a90e2; border-color: #3a7bc8; color: #ffffff; width: auto; align-self: flex-start; padding: 2px 14px; }
.novahn-studio .primary-button:hover { background-color: #357abd; border-color: #3a7bc8; }
.novahn-studio .action-button.server-running { background-color: var(--unity-colors-button-background); color: #e06c6c; }
.novahn-studio .action-button.server-running:hover { background-color: var(--unity-colors-button-background-hover); }
